# Supabase Configuration
# Get these from: https://app.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (invites, onboarding) — src/shared/lib/mailer.ts
RESEND_API_KEY=re_your-resend-key
# Log outgoing email to the console instead of sending (development convenience)
DEV_EMAIL_LOG=true

# Distributed rate limiting — activates Upstash Redis store when both are set.
# Without them the proxy falls back to an in-process (per-instance) store.
UPSTASH_REDIS_REST_URL=https://your-upstash-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Rate limit caps (requests per minute). Defaults used when unset.
# E2E tests relax these via playwright.config.ts webServer env.
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_MAX=60
RATE_LIMIT_GENERAL_MAX=100

# Set to 1 to fail closed (deny) on unverifiable admin/suspension lookups.
# Default posture is fail-open for availability.
MIDDLEWARE_FAIL_CLOSED=0

# Supabase Management API token — used by scripts (e.g. scripts/smoke-org-admin.mjs
# teardown, schema migration verification) to run superuser SQL.
SUPABASE_MGMT_TOKEN=sbp_your-management-token

# Stripe billing — src/features/billing/actions.ts + src/app/api/webhooks/stripe/route.ts.
# Checkout, the customer portal, and cancellation are DISABLED (graceful
# degradation; plan limits still enforce) until STRIPE_SECRET_KEY is set.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Verify from: https://dashboard.stripe.com/webhooks (endpoint /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
